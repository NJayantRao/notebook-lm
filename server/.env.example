# Logging
# debug | info | warn | error (defaults to debug in development, info in production)
LOG_LEVEL=info
# Set to true to also write structured logs to app.log
LOG_TO_FILE=false

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External services
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
MEM0_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# provider:model, e.g. openai:gpt-6-luna / openai:gpt-6.2-sol / anthropic:claude-sonnet-5-5 / google:gemini-3.8-flash
CHAT_MODEL=
ARTIFACT_MODEL_FAST=
ARTIFACT_MODEL_STRONG=
# Current Gemini TTS model per https://ai.google.dev/gemini-api/docs/models
TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE_HOST_A=Kore
TTS_VOICE_HOST_B=Orbit
MAX_ARTIFACT_CONTEXT_TOKENS=90000
ARTIFACTS_PER_DAY=20
PODCASTS_PER_DAY=3
# Hard cap of 300 seconds; values above 300 are rejected at startup.
PODCAST_MAX_SECONDS=300
# Speech-rate estimate used to size the script before synthesis.
PODCAST_WORDS_PER_MINUTE=125
AUDIO_URL_TTL_SECONDS=3600
PINECONE_API_KEY=
PINECONE_INDEX=

# S3-compatible storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_KEY_PREFIX=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_BASE_URL=

# Inngest
INNGEST_DEV=true
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
